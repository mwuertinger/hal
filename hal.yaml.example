mqtt:
  # Address of the MQTT broker. The connection is TLS.
  server:         mqtt.example.com:8883
  # CA certificate the broker's own certificate is verified against.
  ca-path:        /etc/hal/ca.crt
  user:           hal
  password:       changeme

http:
  # Address the web frontend listens on. Must match SocketBindAllow= in
  # hal.service, which allows tcp:8080 by default.
  listen-address: :8080
  # Only needed to reach HAL under a registrable domain name: IP addresses,
  # single-label names, names under .local, .lan, .home, .home.arpa,
  # .internal, .localhost or .localdomain, and fritz.box are always accepted.
  # Anything else is refused, so that a public page cannot point its own domain
  # at HAL and drive it through a visitor's browser.
  #allowed-hosts:
  #- hal.example.com

# sonoff-mqtt-switch is currently the only supported device type. The id is the
# Tasmota topic name: HAL publishes to cmnd/<id>/POWER and subscribes to
# stat/<id>/POWER and tele/<id>/STATE. Devices are grouped by location in the UI.
devices:
- id:       socket01
  type:     sonoff-mqtt-switch
  name:     Floor Lamp
  location: Living Room
- id:       socket02
  type:     sonoff-mqtt-switch
  name:     Desk Lamp
  location: Office
